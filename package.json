{
  "name": "code-forge",
  "version": "0.2.0",
  "description": "对抗回环插件:宿主 agent 自己执行(零 key),判定与预算交给代码,过程直播到本地监控台",
  "bin": {
    "code-forge": "server.js"
  },
  "main": "server.js",
