    "test": "node test-host.js && node test.js"
  },
  "files": [
    "server.js",
    "hostrun.js",
    "loop.js",
    "gate.js",
    "providers.js",
    "mcp.js",
    "demo.js",
    "index.html",
    "setup.html",
    "skills",
    "commands",
    ".claude-plugin",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "license": "MIT"
}
