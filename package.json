{
  "name": "code-forge",
  "version": "0.2.0",
  "description": "对抗回环插件:宿主 agent 自己执行(零 key),判定与预算交给代码,过程直播到本地监控台",
  "bin": {
    "code-forge": "server.js"
  },
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "mcp": "node server.js --mcp",
    "demo": "node server.js --reset --demo --live",
    "test": "node test-host.js && node test.js"
  },
  "//files": "server.js 会 require 这里的每一个 .js —— 漏一个,装出去的包就是坏的(踩过:tui/agentrun/agentcli/gatesuggest 全漏了)。加文件时对照 require 一遍。",
  "files": [
    "server.js",
    "install.js",
    "hostrun.js",
    "loop.js",
    "gate.js",
    "judge.js",
    "providers.js",
    "mcp.js",
    "demo.js",
    "tui.js",
    "hookprompt.js",
    "usage.js", "chatusage.js",
    "adapters.js",
    "perrole.js",
    "agentcli.js",
    "index.html",
    "setup-local.html",
    "skills",
    "commands",
    "agents",
    ".claude-plugin",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "private": true,
  "license": "MIT"
}
